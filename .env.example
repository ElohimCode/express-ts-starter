# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=10000

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Authentication
JWT_ACCESS_SECRET=starter_kit_access_secret_min_32_characters_long_for_security
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=starter_kit_refresh_secret_min_32_characters_long_for_security
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ISSUER=express-starter-kit
JWT_AUDIENCE=express-starter-kit-api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/express_starter?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Background Worker
WORKER_CONCURRENCY=5
OUTBOX_DISPATCH_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY_MS=2000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
